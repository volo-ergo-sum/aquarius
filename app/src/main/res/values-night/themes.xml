<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Launch theme. Android 12 and up draw a splash from these attributes
         whether or not you ask for one; left at their defaults you get a static
         icon on the system window background, which flashes light on a dark
         page. Both colours are pinned to the page's own, so the splash and the
         first frame of the page are the same colour and the launch reads as one
         continuous thing.

         The animation is capped at 1000ms by the platform - anything longer is
         truncated, not waited for - so the two waves finish at 760ms with room
         to spare. -->
    <style name="Theme.Aquarius.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Aquarius</item>
    </style>

    <!-- NoActionBar: the page is the whole UI. -->
    <style name="Theme.Aquarius" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
